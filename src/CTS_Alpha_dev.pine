 + str.tostring(entryLocationScore) + " (" + entryLocationState + ")" + "\n" + "Momentum (15%) : " + str.tostring(entryMomentumScore) + "\n" + "Context (20%) : " + str.tostring(entryContextScore) + "\n" + "Entry Score : " + str.tostring(engineEntryScore) + "\n" + "Entry State : " + entryState + "\n" + "Entry Price : " + str.tostring(engineEntryPrice) + "\n" + "Entry Adjustment : " + str.tostring(baseAdjustment) + "\n" + "Entry Dist ATR : " + str.tostring(entryDistanceATR) + "\n" + "Position (Retained) : " + str.tostring(entryPositionScore) + "\n" + "Impulse Align : " + str.tostring(entryImpulseScore) + "\n" + "Market Score : " + str.tostring(engineMarketScore) + " (" + marketQualityState + ")" + "\n" + "Opportunity : " + str.tostring(engineOpportunityScore) + " (" + opportunityState + ")" + "\n" + "Execution : " + str.tostring(engineExecutionScore) + " (" + executionQualityState + ")" + "\n" + "Decision : " + decisionState + "\n" + "Trade Mode : " + tradeMode + "\n" + "Decision Stage : " + decisionStage + "\n" + "Decision Score : " + str.tostring(engineDecisionScore) + "\n" + "Decision Quality : " + decisionQuality + "\n" + "Reason : " + decisionReason + "\n" + "Detail : " + decisionDetailReason + "\n" + "Next Action : " + nextAction + "\n" + "Trigger : " + nextTrigger + "\n" + "\n--- EXECUTION GUARD V1 ---" + "\n" + "State : " + executionState + "\n" + "Gate : " + executionGate + "\n" + "Gates : " + executionGateSummary + "\n" + "Conditional : " + str.tostring(executionGateConditionalCount) + "\n" + "Decision Gate : " + decisionGateState + "\n" + "Direction Gate : " + directionGateState + "\n" + "Structure Gate : " + structureGateState + "\n" + "Risk Gate : " + riskGateState + "\n" + "Entry Gate : " + entryGateState + "\n" + "--- RISK INTELLIGENCE GATE ---" + "\n" + "Risk Score : " + str.tostring(engineRiskScore) + "\n" + "Risk State : " + riskState + "\n" + "Gate State : " + riskIntelligenceGateState + "\n" + "--- ENTRY LOCATION GATE ---" + "\n" + "Location Score : " + str.tostring(entryLocationScore) + "\n" + "Location State : " + entryLocationState + "\n" + "Distance ATR : " + str.tostring(entryDistanceATR) + "\n" + "Entry State : " + entryState + "\n" + "Gate Reason : " + executionBlockReason + "\n" + "Gate Detail : " + executionDetailReason + "\n" + "\nTrade Setup:" + "\nEntry: " + (na(tradeEntryPrice) ? "NA" : str.tostring(tradeEntryPrice)) + "\nStop: " + (na(tradeStopLoss) ? "NA" : str.tostring(tradeStopLoss)) + "\nTarget: " + (na(tradeTarget) ? "NA" : str.tostring(tradeTarget)) + "\nRR: " + (na(tradeRiskReward) ? "NA" : str.tostring(tradeRiskReward))

if debugMode
    if na(debugLabel)
        debugLabel := label.new(
             bar_index,
             high,
             "",
             style = label.style_label_left,
             size = size.small)

    label.set_xy(debugLabel,bar_index + 1,high + ctxATR * 1.5)
    
